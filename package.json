{
  "name": "mcp-server-SDK",
  "description": "MCP Server and Orchestrator - Monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "cd packages/shared && npm run build",
    "build:mcp-server": "cd services/mcp-server && npm run build",
    "build:orchestrator": "cd services/orchestrator && npm run build",
    "dev:shared": "cd packages/shared && npm run dev",
    "dev:mcp-server": "cd services/mcp-server && npm run dev",
    "dev:orchestrator": "cd services/orchestrator && npm run dev",
    "start:mcp-server": "cd services/mcp-server && npm run start",
    "start:inspector-mcp": "npx @modelcontextprotocol/inspector@latest --url http://localhost:3000/mcp",
    "start:orchestrator": "cd services/orchestrator && npm run start",
    "prisma:generate": "cd services/mcp-server && npm run prisma:generate",
    "prisma:migrate": "cd services/mcp-server && npm run prisma:migrate",
    "prisma:studio": "cd services/mcp-server && npm run prisma:studio",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "install:all": "npm install && npm run build:shared"
  },
  "devDependencies": {
    "@types/node": "20.14.2",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.44.1"
  }
}
