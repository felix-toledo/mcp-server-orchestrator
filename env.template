# Ejemplo de variables de entorno para docker-compose
# Copia este archivo a .env y ajusta los valores según tu configuración

# ========================================
# General
# ========================================
NODE_ENV=production

# ========================================
# Base de datos externa (PostgreSQL)
# ========================================
# La base de datos está deployada externamente, proporciona la URL completa de conexión
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_bd

# ========================================
# MCP Server
# ========================================
MCP_SERVER_PORT=3000

# ========================================
# Orchestrator
# ========================================
ORCHESTRATOR_PORT=3001
MCP_SERVER_URL=http://mcp-server:3000/mcp
OPENAI_API_KEY=tu-api-key-aqui

# ========================================
# Otras variables de entorno
# ========================================
# Agrega aquí cualquier otra variable que necesites

KEY_ALLOWED_AGENTS=tu-key
