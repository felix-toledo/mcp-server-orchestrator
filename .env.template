# Example environment variables for docker-compose.
# Copy this file to .env and adjust the values for your setup.
# Port numbers must match the registry in docs/ports.md.

# ========================================
# General
# ========================================
NODE_ENV=production

# ========================================
# External database (PostgreSQL)
# ========================================
# The database is deployed externally — provide the full connection URL.
DATABASE_URL=postgresql://user:password@host:port/db_name

# ========================================
# MCP Server (port 30020, see docs/ports.md)
# ========================================
MCP_SERVER_PORT=30020

# ========================================
# Orchestrator (port 30021, see docs/ports.md)
# ========================================
ORCHESTRATOR_PORT=30021
MCP_SERVER_URL=http://mcp-server:30020/mcp
KEY_ALLOWED_AGENTS=your-key

# ========================================
# Frontend (planned, port 30022 — see docs/ports.md)
# ========================================
# FRONTEND_PORT=30022
# CORS_ORIGIN=http://localhost:30022

# ========================================
# LLM Provider (openai | deepseek | gemini | copilot)
# ========================================
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4.1-nano

# DeepSeek (only if LLM_PROVIDER=deepseek) - OpenAI-compatible API
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini (only if LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash
