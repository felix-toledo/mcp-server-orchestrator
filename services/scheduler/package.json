{
  "name": "@mcp-server-sma/scheduler",
  "version": "1.0.0",
  "description": "ALMA scheduler - pg-boss-backed one-off and recurring reminders, delivered over Telegram",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch --loader ts-node/esm src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mcp-server-sma/shared": "workspace:*",
    "@prisma/client": "6.16.2",
    "dotenv": "^17.2.3",
    "express": "4.21.2",
    "pg-boss": "^10.1.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.14.2",
    "@types/supertest": "^7.2.1",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.44.1",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
