# Copy to .env and fill in real values. See docs/ports.md and
# .specify/specs/scheduler/001-agendas/spec.md §5.2.
#
# Same Postgres container as knowledge-store (see docker-compose.yml), a
# different logical database (`alma_scheduler`, not `alma`) — spec §2's
# service-isolation reasoning, not a hard infrastructure requirement.
# pg-boss creates its own internal schema inside this same database
# automatically on first start.

PORT=30026
DATABASE_URL=postgresql://alma:alma@localhost:15432/alma_scheduler?sslmode=disable
TELEGRAM_BOT_URL=http://localhost:30023
