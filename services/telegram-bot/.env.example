# Copy to .env and fill in real values. See docs/ports.md and
# .specify/specs/telegram-bot/001-channel/spec.md §5.
#
# No TELEGRAM_BOT_TOKEN here — the token lives in knowledge-store's
# TelegramLink (set via PUT /telegram-link, normally from the frontend's
# Settings tab), fetched on startup and whenever /config changes it.

PORT=30023
KNOWLEDGE_STORE_URL=http://localhost:30025
ORCHESTRATOR_URL=http://localhost:30021
KEY_ALLOWED_AGENTS=your-secret-key
