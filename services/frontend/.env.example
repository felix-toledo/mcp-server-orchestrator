# Copy to .env and fill in real values. See docs/ports.md and the
# frontend/00x specs under .specify/specs/frontend/.

PORT=30022
ORCHESTRATOR_URL=http://localhost:30021
KNOWLEDGE_STORE_URL=http://localhost:30025

# Sent as the KAA header when calling the orchestrator's /api/inquire —
# must match services/orchestrator/.env's KEY_ALLOWED_AGENTS.
KEY_ALLOWED_AGENTS=your-secret-key
