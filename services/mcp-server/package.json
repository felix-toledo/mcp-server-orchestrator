{
  "name": "@mcp-server-sma/mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for SMA - Core MCP server implementation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch --loader ts-node/esm src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mcp-server-sma/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.18.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/node": "20.14.2",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5",
    "typescript-eslint": "8.44.1",
    "vitest": "^3.2.4"
  }
}
