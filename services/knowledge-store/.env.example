# Copy to .env and fill in real values. See docs/ports.md and
# .specify/specs/knowledge-store/001-vectorization/spec.md §5.4.
#
# Port 15432, not the Postgres-standard 5432 or docker-compose's original
# 5433 default: on this dev machine, Prisma's engine (CLI *and* runtime)
# silently failed to reach Postgres on 5433 specifically — TCP connected,
# but Postgres's own connection log never showed the attempt, and every
# query came back `P1010: User was denied access on the database
# (not available)` regardless of credentials. 5432 was also unavailable
# (an unrelated project's Postgres already listens there). 15432 just
# works. If you ever change `POSTGRES_PORT` in `docker-compose.yml`, retest
# with `npx prisma db execute --schema prisma/schema.prisma --stdin <<<
# "SELECT 1;"` before trusting it.

PORT=30025
DATABASE_URL=postgresql://alma:alma@localhost:15432/alma?sslmode=disable

# Embeddings only (the LLM itself is DeepSeek, configured in services/orchestrator)
OPENAI_API_KEY=sk-your-key-here
EMBEDDINGS_MODEL=text-embedding-3-small
