PORT=30028
ORCHESTRATOR_URL=http://localhost:30021
KEY_ALLOWED_AGENTS=your-secret-key
KNOWLEDGE_STORE_URL=http://localhost:30025
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
UTTERANCE_DURATION_SECONDS=5
OPENAI_API_KEY=sk-...      # same key knowledge-store uses for embeddings — STT (AC4)
# Optional — case-insensitive substring match against PyAudio's device
# names (e.g. "Realtek"). Unset uses the OS default input device, which
# isn't always the mic you actually want (e.g. a virtual webcam-app mic
# registered as the Windows default). Run
# `python -c "import pyaudio; pa = pyaudio.PyAudio(); [print(i, pa.get_device_info_by_index(i)['name']) for i in range(pa.get_device_count())]"`
# to list your machine's devices and their names.
AUDIO_INPUT_DEVICE_NAME=
# Kokoro requires an explicit voice. "ef_dora" is Spanish (female) — the
# other two Spanish voices are "em_alex"/"em_santa" (male). English voices
# (e.g. "af_heart") also work if you change main.py's lang_code to "a".
KOKORO_VOICE=ef_dora
# Optional. Settings > Voz's "ElevenLabs" engine only works when this is
# set — unset always falls back to the free Kokoro voice above, even if a
# user picked ELEVENLABS in the frontend. Get one at elevenlabs.io.
ELEVENLABS_API_KEY=
